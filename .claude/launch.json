{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "exec npm --prefix frontend run dev -- --port \"${PORT:-5174}\" --strictPort"
      ],
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && exec .venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "backend-verify",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && exec .venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8199"
      ],
      "port": 8199
    },
    {
      "name": "scrape-progress",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd ../catalog-extraction && exec .venv/bin/python scripts/progress_server.py --port \"${PORT:-8351}\""
      ],
      "autoPort": true
    },
    {
      "name": "what2eat-mock",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd ../../what-2-eat && AI_SCAN_MOCK=1 exec .venv/bin/python -m uvicorn server:app --host 127.0.0.1 --port \"${PORT:-8010}\""
      ],
      "autoPort": true
    }
  ]
}