{
  "supplier_key": "american_best",
  "supplier_name": "American Best",
  "season": "2026",
  "login": {
    "url": "https://americanbest.com/login",
    "username_env": "SUPPLIER_USERNAME",
    "password_env": "SUPPLIER_PASSWORD",
    "username_selector": "input[name='email'], input[type='email'], input[name='username']",
    "password_selector": "input[name='password'], input[type='password']",
    "submit_selector": "button[type='submit'], input[type='submit']",
    "post_login_wait_seconds": 3
  },
  "start_urls": [
    "https://americanbest.com/"
  ],
  "listing": {
    "product_link_selector": "a[href*='/products/'], a[href*='/product/'], a[href$='.html']",
    "next_selector": "a[rel='next'], a.next, .pagination a[aria-label='Next']",
    "max_listing_pages": 25
  },
  "product": {
    "sku": "[itemprop='sku'], .sku, .product-sku, [data-sku]",
    "name": "h1, .product-title, .product-name",
    "description": "[itemprop='description'], .product-description, .description",
    "category": ".breadcrumb, nav[aria-label='breadcrumb']",
    "price": "[itemprop='price'], .price, .product-price",
    "uom": ".uom, .unit, .unit-of-measure",
    "moq": ".moq, .minimum-order, .minimum-quantity",
    "box_qty": ".box-qty, .box-quantity",
    "case_qty": ".case-qty, .case-quantity, .carton-qty",
    "availability": ".availability, .stock, .inventory",
    "dimensions": ".dimensions, .product-dimensions",
    "image": "img[itemprop='image'], .product-gallery img, .product-image img, img"
  }
}
